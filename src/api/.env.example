# API en local : copier en .env (BDD dans Docker : npm run db:up)

NODE_ENV=development


PORT=4050
# (pour différencier PORT=4000 de l'API Docker)

# Site autorisé à appeler l'API (CORS) : le front
ALLOWED_ORIGINS=http://localhost:3000

# Port publié par Docker (POSTGRES_PORT)
DATABASE_URL=postgres://graine:A_REMPLIR@localhost:5433/graine

# Instructions de paiement affichées après une commande (vides : valeurs fictives de config.ts)
PAYMENT_IBAN=
PAYMENT_BIC=
PAYMENT_HOLDER=
PAYMENT_CHECK_PAYABLE_TO=
PAYMENT_CHECK_ADDRESS=
