### 201 · inscription complète (association)
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Camille",
  "lastname": "Martin",
  "email": "camille@test.fr",
  "password": "Camille12345!",
  "accountType": "association",
  "organizationName": "Les Amis des Chênes"
}

### 201 · sans accountType ni organizationName (doit renvoyer "particulier")
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Hugo",
  "lastname": "Petit",
  "email": "hugo@test.fr",
  "password": "Hugo123456789!"
}

### 201 · organizationName à null
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Léa",
  "lastname": "Roux",
  "email": "lea@test.fr",
  "password": "Lea1234567890!",
  "accountType": "particulier",
  "organizationName": null
}

### 400 · mot de passe trop court (moins de 12 caractères)
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Camille",
  "lastname": "Martin",
  "email": "camille.court@test.fr",
  "password": "court"
}

### 400 · prénom vide
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "",
  "lastname": "Groot",
  "email": "groot.vide@test.fr",
  "password": "JesappelleGroot!"
}

### 400 · nom absent
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Groot",
  "lastname": "",
  "email": "groot.sansnom@test.fr",
  "password": "JesappelleGroot!"
}

### 400 · email invalide
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Camille",
  "lastname": "Martin",
  "email": "pas-un-email",
  "password": "Camille12345!"
}

### 400 · type de compte inconnu
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Howard Phillips",
  "lastname": "Lovecraft",
  "email": "hpl.type@test.fr",
  "password": "Lovecraft12345!",
  "accountType": "author"
}

### 409 · email déjà utilisé (alice existe dans le seed) — étape 3
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Alice",
  "lastname": "Martin",
  "email": "alice@test.fr",
  "password": "Alice12345678!"
}

### 415 · body envoyé en texte, pas en JSON — étape 7
POST http://localhost:4000/api/users HTTP/1.1
content-type: text/plain

firstname=Camille


### 200 · connexion alice (client du seed)
POST http://localhost:4000/api/auth HTTP/1.1
content-type: application/json

{
  "email": "alice@test.fr",
  "password": "Client12345!"
}

### 200 · connexion dimitry (admin du seed)
POST http://localhost:4000/api/auth HTTP/1.1
content-type: application/json

{
  "email": "dimitry@graine.fr",
  "password": "Admin123456!"
}

### 403 · connexion bob (compte désactivé du seed)
POST http://localhost:4000/api/auth HTTP/1.1
content-type: application/json

{
  "email": "bob@test.fr",
  "password": "Client12345!"
}

### email neuf
POST http://localhost:4000/api/users HTTP/1.1
content-type: application/json

{
  "firstname": "Anakin",
  "lastname": "Skywalker",
  "email": "anakin@test.fr",
  "password": "IwantToBeAMasterJed1!"
}

# Pour tester F6 · à lancer dans l'ordre, à partir de « email neuf » :
# le cookie de la connexion est gardé par l'extension REST Client
### 200 · connexion anakin
POST http://localhost:4000/api/auth HTTP/1.1
content-type: application/json

{
  "email": "anakin@test.fr",
  "password": "IwantToBeAMasterJed1!"
}

### 200 · modifier mon compte
PATCH http://localhost:4000/api/users/me HTTP/1.1
content-type: application/json

{
  "firstname": "Anakin",
  "lastname": "Skywalker",
  "email": "anakin@test.fr",
  "address": "1 rue de Tatooine, 35000 Rennes",
  "accountType": "association",
  "organizationName": "Les Graines"
}

### 400 · type de compte absent
PATCH http://localhost:4000/api/users/me HTTP/1.1
content-type: application/json

{
  "firstname": "Anakin",
  "lastname": "Skywalker",
  "email": "anakin@test.fr",
  "address": null
}

### 400 · mot de passe actuel incorrect
PATCH http://localhost:4000/api/users/me/password HTTP/1.1
content-type: application/json

{
  "currentPassword": "mauvais-mot-de-passe",
  "newPassword": "NouveauSecret123!"
}

### 204 · changer mon mot de passe
PATCH http://localhost:4000/api/users/me/password HTTP/1.1
content-type: application/json

{
  "currentPassword": "IwantToBeAMasterJed1!",
  "newPassword": "NouveauSecret123!"
}

### 204 · supprimer mon compte (409 si je suis le dernier admin actif)
DELETE http://localhost:4000/api/users/me HTTP/1.1