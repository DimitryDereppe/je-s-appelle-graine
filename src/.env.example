# Base de données
POSTGRES_USER=graine
POSTGRES_PASSWORD=a_remplir
POSTGRES_DB=graine
# Adresse vue depuis un conteneur (l'API dans Docker) : hôte "db"
DATABASE_URL=postgres://graine:a_remplir@db:5432/graine
# Depuis sa machine (API lancée avec npm run dev) : remplacer "db" par "localhost"

# API
PORT=4000

# Front (adresse de l'API vue depuis le conteneur du front)
API_URL=http://api:4000