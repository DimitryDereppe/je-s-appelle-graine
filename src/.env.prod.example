# Modèle du .env de PRODUCTION (sur le VPS, dans src/) : cp .env.prod.example .env puis remplir.
# Générer chaque mot de passe ou secret avec : openssl rand -hex 32
# (hexadécimal : un "/", "+" ou "@" casserait DATABASE_URL)

# Adresse du site (sans https://)
DOMAINE=PSEUDO-server.eddi.cloud

# Base de données
POSTGRES_USER=graine
POSTGRES_PASSWORD=a_remplir
POSTGRES_DB=graine
# Même mot de passe que POSTGRES_PASSWORD ; hôte "db" (le service Docker)
DATABASE_URL=postgres://graine:a_remplir@db:5432/graine

# API
NODE_ENV=production
PORT=4000
# Clé qui signe les jetons de connexion : openssl rand -hex 32 (obligatoire, sinon l'API ne démarre pas)
JWT_SECRET=
# Site autorisé à appeler l'API depuis un navigateur (CORS) : le même que SITE_URL
ALLOWED_ORIGINS=https://PSEUDO-server.eddi.cloud
# Instructions de paiement affichées après une commande
# IBAN, BIC et adresse du chèque obligatoires : sans eux, l'API refuse de démarrer
PAYMENT_IBAN=
PAYMENT_BIC=
PAYMENT_HOLDER=Je s'appelle Graine
PAYMENT_CHECK_PAYABLE_TO=Je s'appelle Graine
PAYMENT_CHECK_ADDRESS=
# Emails aux clients : confirmation de commande (F5) et changement de statut (F8), avec Nodemailer
# SMTP_HOST vide = aucun envoi : l'email est seulement affiché dans les logs de l'API (comme en développement)
SMTP_HOST=smtp.gmail.com
# 587 avec SMTP_SECURE=false (la connexion est chiffrée ensuite) ; 465 avec SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
# Compte Gmail de l'équipe
SMTP_USER=jesappellegraine@gmail.com
# Mot de passe d'application Gmail : les 16 lettres à la suite, sans espaces ni guillemets
# (pas le mot de passe du compte)
SMTP_PASSWORD=
# Expéditeur affiché au client (Gmail impose l'adresse du compte)
SMTP_FROM=Je s'appelle Graine <jesappellegraine@gmail.com>

# Front (au démarrage). Les rewrites de next.config.ts, eux, prennent API_URL au build :
# valeur fixée par ARG API_URL dans front/Dockerfile.prod (à changer aussi là si elle change ici).
API_URL=http://api:4000
SITE_URL=https://PSEUDO-server.eddi.cloud
