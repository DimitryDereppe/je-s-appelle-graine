@startuml 01b-diagramme-architecture
!pragma layout smetana
title Je s’appelle Graine — Architecture de l'application

actor "Visiteur, client\nou administrateur" as user

node "Appareil utilisateur" {
  rectangle "Navigateur web" as browser
}

node "VPS O'Clock — conteneurs Docker (Docker Compose)" as vps {
  rectangle "Serveur web Nginx\n(HTTPS)" as web
  rectangle "Front-end\nNext.js / React (TypeScript)" as front
  node "API REST — Node.js / Express (TypeScript)" as api {
    rectangle "Routes et middlewares\n(validation, JWT, rôles)" as routes
    rectangle "Contrôleurs" as ctrl
    rectangle "Services métier" as services
    rectangle "DataMappers" as mappers
  }
  database "PostgreSQL\n(base non exposée sur Internet,\nvolume sauvegardé hors du VPS)" as db
}

cloud "Service d'envoi\nd'emails (SMTP)" as smtp
rectangle "Boîte mail\ndu client" as mailbox

user --> browser : utilise le site
browser --> web : HTTPS\n(un seul nom de domaine)\n+ cookie httpOnly (JWT)
web --> front : pages
web --> routes : requêtes /api/...
routes --> ctrl
ctrl --> services
services --> mappers
mappers --> db : requêtes SQL paramétrées\n(réseau Docker interne)
services --> smtp : confirmation, paiement reçu,\nannulation
smtp --> mailbox

note right of web
  Aiguille les requêtes :
  /api/... vers l'API,
  le reste vers le front-end.
end note

note right of services
  Règles métier : disponibilité,
  calcul du total, engagement
  de paiement, statuts, emails.
end note

note as dev
  En développement : les mêmes conteneurs
  (front-end, API, PostgreSQL) sont lancés
  en local avec Docker Compose.
end note
@enduml
